# Code Belaraby - Environment Configuration Example

# General Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=supersecretkey_change_me_in_production_minimum_32_chars_long!
API_V1_STR=/api/v1
PROJECT_NAME="كود بالعربي"
RUN_SEED=false

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
CSRF_SECRET=csrf_super_secret_key_32_characters_at_least!
SIGNED_URL_SECRET=signed_url_super_secret_key_32_characters_at_least!
RECEIPT_SIGNING_SECRET=receipt_signing_secret_32_characters_at_least!
VIDEO_SIGNING_SECRET=video_signing_secret_32_characters_at_least!
CSRF_TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
SECURE_COOKIES=false

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_journey_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_journey_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/code_journey_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Code Execution
JUDGE0_URL=http://localhost:2358
JUDGE0_API_URL=
JUDGE0_API_KEY=
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=true
ALLOW_LOCAL_RUNNER_IN_PROD=false
USE_MOCK_JUDGE0=false

# Video Provider
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PEM_KEY=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
USE_MOCK_VIDEO_PROVIDER=false

# File Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage_uploads
PRIVATE_STORAGE_LOCAL_DIR=./private_storage
PUBLIC_ASSETS_LOCAL_DIR=./public_assets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=payment-receipts
S3_ENDPOINT_URL=https://mock.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=code-journey-uploads

# Frontend App URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
