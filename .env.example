# Code Belaraby - Environment Configuration Example

# General Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=supersecretkey_change_me_in_production_minimum_32_chars_long!
API_V1_STR=/api/v1
PROJECT_NAME="كود بالعربي"
RUN_SEED=false

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]
CSRF_SECRET=csrf_super_secret_key_32_characters_at_least!
COOKIE_DOMAIN=localhost
SECURE_COOKIES=false

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=code_journey_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_journey_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/code_journey_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Code Execution (Judge0 Adapter)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=mock_key_development
USE_MOCK_JUDGE0=true

# Video Provider (Cloudflare Stream Adapter)
CLOUDFLARE_STREAM_ACCOUNT_ID=mock_cf_account
CLOUDFLARE_STREAM_API_TOKEN=mock_cf_token
CLOUDFLARE_STREAM_KEY_ID=mock_cf_key_id
CLOUDFLARE_STREAM_PEM_KEY=mock_cf_pem_key
USE_MOCK_VIDEO_PROVIDER=true

# File Storage Adapter (R2 / S3 / Local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT_URL=https://mock.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=mock_access_key
S3_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=code-journey-uploads

# Frontend App URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
