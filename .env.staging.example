# Code Belaraby - Staging Environment Configuration Template (.env.staging.example)
# IMPORTANT: Copy this file to .env.staging outside version control and replace every placeholder.

ENVIRONMENT=staging
DEBUG=false

# Security & Secrets
SECRET_KEY=change_me_to_a_random_secure_32_character_string_for_staging
CSRF_SECRET=change_me_to_a_random_secure_32_character_csrf_secret
SIGNED_URL_SECRET=change_me_to_a_random_secure_32_character_signed_url_secret
RECEIPT_SIGNING_SECRET=change_me_to_a_random_secure_32_character_receipt_secret
VIDEO_SIGNING_SECRET=change_me_to_a_random_secure_32_character_video_secret

# Default Passwords for Seeded Administrative Accounts
ADMIN_DEFAULT_PASSWORD=Set_Unique_Admin_Password_For_Staging_Here!
INSTRUCTOR_DEFAULT_PASSWORD=Set_Unique_Instructor_Password_For_Staging_Here!
STUDENT_DEFAULT_PASSWORD=Set_Unique_Student_Password_For_Staging_Here!

# Database Configuration
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_postgres_secure_password_replace_me
POSTGRES_DB=code_belaraby_staging_db
DATABASE_URL=postgresql+asyncpg://staging_user:staging_postgres_secure_password_replace_me@postgres:5432/code_belaraby_staging_db
SYNC_DATABASE_URL=postgresql+psycopg2://staging_user:staging_postgres_secure_password_replace_me@postgres:5432/code_belaraby_staging_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Storage
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role
SUPABASE_STORAGE_BUCKET=payment-receipts

# Network & Domain Settings
ALLOWED_ORIGINS=["https://staging.example.com"]
CSRF_TRUSTED_ORIGINS=["https://staging.example.com"]
COOKIE_DOMAIN=staging.example.com
COOKIE_SAMESITE=none
SECURE_COOKIES=true

# Code Execution Sandbox Configuration
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
ALLOW_LOCAL_RUNNER_IN_PROD=false
JUDGE0_URL=https://your-judge0-staging.example.com

# Optional private video provider credentials
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PEM_KEY=
CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=

# Seed Safety
RUN_SEED=false
