# Code Belaraby - Free Staging Environment Template (.env.free-staging.example)
# Use this template for free hosting on Vercel + Render + Supabase + Upstash Redis.

ENVIRONMENT=staging
DEBUG=false

# Security & Secrets (Generate 32+ random characters)
SECRET_KEY=change_me_to_a_random_secure_32_character_string_for_staging
CSRF_SECRET=change_me_to_a_random_secure_32_character_csrf_secret
SIGNED_URL_SECRET=change_me_to_a_random_secure_32_character_signed_url_secret

# Supabase PostgreSQL Database (Transaction & Direct Pooler connection strings)
# Example: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.your_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Example: postgresql+psycopg2://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres.your_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Upstash Redis Cache (supports rediss:// TLS protocol out of the box)
# Example: rediss://default:your_token@your-endpoint.upstash.io:6379
REDIS_URL=rediss://default:your_upstash_redis_token@your-redis-endpoint.upstash.io:6379

# Supabase Private Storage Bucket Configuration
SUPABASE_URL=https://your-supabase-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=payment-receipts

# Domain & CORS Settings (Vercel Frontend URL)
ALLOWED_ORIGINS=["https://code-belaraby-staging.vercel.app"]
SECURE_COOKIES=true

# Operational & Safety Flags
RUN_SEED=false
ALLOW_LOCAL_RUNNER_IN_PROD=false
