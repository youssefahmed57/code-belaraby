# Free-tier staging example for Vercel + Render + Supabase + Upstash

ENVIRONMENT=staging
DEBUG=false

SECRET_KEY=replace_with_random_32_char_secret
CSRF_SECRET=replace_with_random_32_char_csrf_secret
SIGNED_URL_SECRET=replace_with_random_32_char_signed_url_secret
RECEIPT_SIGNING_SECRET=replace_with_random_32_char_receipt_secret
VIDEO_SIGNING_SECRET=replace_with_random_32_char_video_secret

DATABASE_URL=postgresql+asyncpg://postgres.your_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres.your_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

REDIS_URL=rediss://default:your_upstash_redis_token@your-endpoint.upstash.io:6379

SUPABASE_URL=https://your-supabase-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role
SUPABASE_STORAGE_BUCKET=payment-receipts

ALLOWED_ORIGINS=["https://code-belaraby-staging.vercel.app"]
CSRF_TRUSTED_ORIGINS=["https://code-belaraby-staging.vercel.app"]
COOKIE_DOMAIN=code-belaraby-staging.vercel.app
COOKIE_SAMESITE=none
SECURE_COOKIES=true

RUN_SEED=false
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
ALLOW_LOCAL_RUNNER_IN_PROD=false
JUDGE0_URL=https://your-judge0-staging.example.com
