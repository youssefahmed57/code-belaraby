# منصة كود بالعربي - قالب بيئة المماثلة المجانية (.env.free-staging.example)
# استخدم هذا الملف لإعداد الحسابات السحابية المجانية على Vercel + Render + Supabase + Upstash Redis.

ENVIRONMENT=staging
DEBUG=false

# المفاتيح السرية (ضع هنا مفتاح سري عشوائي 32 حرف، يولّد بالأمر: openssl rand -hex 32)
SECRET_KEY=ضع_هنا_مفتاح_سري_عشوائي_32_حرف_يولّد_بالأمر_openssl_rand_hex_32
CSRF_SECRET=ضع_هنا_مفتاح_حماية_csrf_عشوائي_32_حرف
SIGNED_URL_SECRET=ضع_هنا_مفتاح_توقيع_صور_الإيصالات_المؤقتة_32_حرف

# روابط اتصال قاعدة البيانات Supabase PostgreSQL
# رابط الاتصال التزامني لـ FastAPI (Transaction Pooler - Port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.your_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# رابط الاتصال التزامني لـ Alembic & Seed (Session/Direct Pooler - Port 5432)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres.your_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# إعدادات حجم مجمّع اتصالات قاعدة البيانات (لمواجهة ضغط الطلاب واللف العالي)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# رابط ذاكرة التخزين المؤقت وطابور التنفيذ Upstash Redis (يدعم بروتوكول المشفر rediss://)
REDIS_URL=rediss://default:your_upstash_redis_token@your-endpoint.upstash.io:6379

# إعدادات حاوية الإيصالات السريّة على Supabase Storage
SUPABASE_URL=https://your-supabase-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ضع_هنا_مفتاح_service_role_الخاص_بـ_supabase
SUPABASE_STORAGE_BUCKET=payment-receipts

# إعدادات الدومينات والنطاقات المسموح بها (CORS)
ALLOWED_ORIGINS=["https://code-belaraby-staging.vercel.app"]
SECURE_COOKIES=true

# أشباه تشغيل الأمان والتجهيز
RUN_SEED=false
ALLOW_LOCAL_RUNNER_IN_PROD=false
